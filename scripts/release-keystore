#!/usr/bin/env bash
# Creates the release signing key and android/keystore.properties.
#
# The key lives outside the repo (default ~/.config/pogo-pocket/release.jks).
# Back it up: Android only installs updates signed with the same key.
set -euo pipefail

dir="${POGO_KEYSTORE_DIR:-$HOME/.config/pogo-pocket}"
jks="$dir/release.jks"
props="$(cd "$(dirname "$0")/.." && pwd)/android/keystore.properties"

if [[ -e "$jks" ]]; then
    echo "$jks already exists; not overwriting it." >&2
    [[ -e "$props" ]] || echo "Write $props by hand (storeFile, storePassword, keyAlias, keyPassword)." >&2
    exit 1
fi
mkdir -p "$dir" && chmod 700 "$dir"
pass="$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)"
keytool -genkeypair -v -keystore "$jks" -storetype PKCS12 -alias pogo-pocket \
    -keyalg RSA -keysize 4096 -validity 10000 \
    -storepass "$pass" -keypass "$pass" -dname "CN=Pogo Pocket" >/dev/null
chmod 600 "$jks"
umask 077
cat > "$props" <<PROPS
storeFile=$jks
storePassword=$pass
keyAlias=pogo-pocket
keyPassword=$pass
PROPS
echo "Created $jks and $props. Back up both: you need them to publish updates."
